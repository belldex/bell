{
  "name": "bell-protocol-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "pnpm test:unit && pnpm test:reference && pnpm policy:check && pnpm compile:solidity && pnpm test:contracts && pnpm abi:check && pnpm --filter @bell/domain check && pnpm --filter @bell/protocol check && pnpm test:runtime:portable && pnpm test:workers && pnpm build:worker && pnpm evidence:check && pnpm check:secrets",
    "test:unit": "node --test packages/domain/test/*.test.mjs packages/protocol/test/*.test.mjs scripts/discovery/*.test.mjs scripts/evidence/*.test.mjs scripts/tooling/*.test.mjs scripts/deploy/*.test.mjs apps/web/test/*.test.mjs",
    "test:domain": "pnpm --filter @bell/domain test",
    "test:contracts": "pnpm exec forge test --root contracts",
    "test:invariants": "node scripts/tooling/blocked-command.mjs test:invariants EVM-invariant-suite-not-implemented",
    "test:reference": "python tests/reference/engineering_checks.py && python tests/reference/infra_spec_checks.py",
    "test:runtime": "pnpm test:runtime:portable && pnpm test:workers",
    "test:runtime:portable": "node --test packages/domain/test/runtime-neutral.test.mjs && deno test packages/domain/test/deno-smoke.ts",
    "test:workers": "pnpm --filter @bell/keeper-b test",
    "build:worker": "pnpm --filter @bell/keeper-b exec wrangler deploy --dry-run --outdir dist",
    "test:e2e": "node scripts/tooling/blocked-command.mjs test:e2e browser-E2E-suite-not-implemented",
    "preflight:rpc": "node scripts/discovery/collect-rpc-preflight.mjs mainnet",
    "preflight:sources": "node scripts/tooling/blocked-command.mjs preflight:sources entitled-source-access-and-verifier-checks-not-available",
    "sources:catalog": "node scripts/discovery/preflight-catalog.mjs mainnet",
    "test:fork": "node scripts/tooling/blocked-command.mjs test:fork pinned-authenticated-fork-prerequisites-not-available",
    "deploy:testnet": "node scripts/deploy/deploy-testnet.mjs",
    "deploy:testnet:dry-run": "node scripts/deploy/deploy-testnet.mjs --dry-run",
    "yahoo:quote": "node scripts/deploy/yahoo-report.mjs",
    "yahoo:report": "node scripts/deploy/yahoo-report.mjs --sign",
    "yahoo:mainnet:preflight": "node scripts/deploy/mainnet-yahoo-preflight.mjs",
    "release:dry-run": "node scripts/tooling/blocked-command.mjs release:dry-run deployable-contracts-and-release-manifest-not-implemented",
    "compile:solidity": "node scripts/tooling/compile-solidity.mjs",
    "abi:generate": "node scripts/evidence/generate-abi.mjs",
    "abi:check": "node scripts/evidence/check-abi.mjs",
    "policy:generate": "node scripts/evidence/generate-policy-constants.mjs",
    "policy:check": "node scripts/evidence/check-policy-constants.mjs",
    "evidence:check": "node scripts/evidence/check-release.mjs",
    "check:secrets": "node scripts/tooling/check-secret-boundary.mjs",
    "tasks:sync": "node scripts/evidence/sync-task-status.mjs",
    "build": "node scripts/tooling/check-build-prerequisites.mjs && pnpm compile:solidity && pnpm --filter @bell/domain check && pnpm --filter @bell/protocol check && pnpm build:worker && pnpm exec forge build --root contracts",
    "check:testnet-addresses": "node scripts/deploy/check-testnet-addresses.mjs",
    "check:testnet-addresses:rpc": "node scripts/deploy/check-testnet-addresses.mjs --rpc",
    "verify:testnet-deployment": "node scripts/deploy/verify-testnet-deployment.mjs",
    "verify:testnet-deployment:check": "node scripts/deploy/verify-testnet-deployment.mjs --check",
    "deploy:activate-asset": "node scripts/deploy/activate-testnet-asset.mjs",
    "deploy:queue-asset": "node scripts/deploy/queue-testnet-asset.mjs",
    "mainnet:preflight": "node scripts/deploy/mainnet-preflight.mjs",
    "mainnet:deploy": "node scripts/deploy/deploy-mainnet.mjs",
    "mainnet:deploy:broadcast": "node scripts/deploy/deploy-mainnet.mjs --broadcast",
    "mainnet:verify": "node scripts/deploy/verify-mainnet-deployment.mjs",
    "mainnet:verify:check": "node scripts/deploy/verify-mainnet-deployment.mjs --check",
    "mainnet:yahoo-stack": "node scripts/deploy/mainnet-yahoo-stack.mjs",
    "mainnet:yahoo-stack:broadcast": "node scripts/deploy/mainnet-yahoo-stack.mjs --broadcast --i-authorize-spend",
    "mainnet:admit:status": "node scripts/deploy/mainnet-admit-assets.mjs status",
    "mainnet:admit:queue": "node scripts/deploy/mainnet-admit-assets.mjs queue --i-authorize-spend",
    "mainnet:admit:activate": "node scripts/deploy/mainnet-admit-assets.mjs activate --i-authorize-spend",
    "mainnet:calendar:plan": "node scripts/deploy/mainnet-calendar.mjs plan",
    "mainnet:calendar:queue": "node scripts/deploy/mainnet-calendar.mjs queue --broadcast --i-authorize-spend",
    "mainnet:calendar:activate-root": "node scripts/deploy/mainnet-calendar.mjs activate-root --broadcast --i-authorize-spend",
    "mainnet:calendar:activate-interval": "node scripts/deploy/mainnet-calendar.mjs activate-interval --broadcast --i-authorize-spend",
    "mainnet:calendar:status": "node scripts/deploy/mainnet-calendar.mjs status",
    "mainnet:reference-stack": "node scripts/deploy/mainnet-reference-stack.mjs",
    "mainnet:reference-stack:broadcast": "node scripts/deploy/mainnet-reference-stack.mjs --broadcast --i-authorize-spend",
    "mainnet:pool": "node scripts/deploy/mainnet-create-pool.mjs",
    "mainnet:pool:plan-matrix": "node scripts/deploy/mainnet-pool-matrix.mjs",
    "mainnet:pool:broadcast": "node scripts/deploy/mainnet-create-pool.mjs --broadcast --i-authorize-spend",
    "mainnet:swap": "node scripts/deploy/mainnet-swap.mjs",
    "mainnet:prepare-oracles": "node scripts/deploy/mainnet-prepare-oracles.mjs",
    "mainnet:acceptance": "node scripts/deploy/mainnet-acceptance.mjs",
    "mainnet:keeper-config": "node scripts/deploy/mainnet-keeper-config.mjs",
    "mainnet:keeper-config:write": "node scripts/deploy/mainnet-keeper-config.mjs --write"
  },
  "devDependencies": {
    "@chainlink/data-streams-sdk": "2.0.0",
    "solc": "0.8.26",
    "viem": "2.57.11"
  },
  "optionalDependencies": {
    "@foundry-rs/forge-darwin-amd64": "1.7.1",
    "@foundry-rs/forge-darwin-arm64": "1.7.1",
    "@foundry-rs/forge-linux-amd64": "1.7.1",
    "@foundry-rs/forge-linux-arm64": "1.7.1",
    "@foundry-rs/forge-win32-amd64": "1.7.1"
  }
}
