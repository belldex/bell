# Public browser configuration only; never put secrets in NEXT_PUBLIC variables.
NEXT_PUBLIC_CHAIN_ID=46630
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-public-placeholder

# Backend-only authenticated endpoints; provision from vendor dashboards.
RH_MAINNET_RPC_PRIMARY=
RH_MAINNET_WSS_PRIMARY=
RH_MAINNET_RPC_SECONDARY=
RH_MAINNET_ARCHIVE_RPC=
RH_TESTNET_RPC_PRIMARY=
RH_TESTNET_WSS_PRIMARY=
RH_TESTNET_RPC_SECONDARY=
RH_TESTNET_ARCHIVE_RPC=
CHAINLINK_SOURCE_CREDENTIAL_A=
CHAINLINK_SOURCE_CREDENTIAL_B=
# Chainlink Testnet uses a separate account database; request explicit testnet Data Streams access.
CHAINLINK_TESTNET_SOURCE_CREDENTIAL=
KEEPER_A_PRIVATE_KEY=
KEEPER_B_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=
TESTNET_TREASURY_ADDRESS=
TESTNET_SERVICE_RECIPIENT=
TESTNET_FEE_TOKEN_ADDRESS=
TESTNET_POOL_CLASS=1
SUPABASE_SERVICE_ROLE_KEY=

# No credentials or production addresses are supplied in this template.
